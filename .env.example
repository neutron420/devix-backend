
SERVER_PORT=8080
SERVER_ENV=development
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

DATABASE_URL=postgresql://user:password@localhost:5432/devix?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Redis (optional — app works without it)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Media Upload
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm
MAX_IMAGES_PER_POST=10

# Cloudflare R2 (required if STORAGE_TYPE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW=1m
