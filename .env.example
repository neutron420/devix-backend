# Server
PORT=8080
ENV=development
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s

DATABASE_URL=postgres://user:password@localhost:5432/devix?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=your-very-secure-access-secret
JWT_REFRESH_SECRET=your-very-secure-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

STORAGE_TYPE=local
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CDN_URL=

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=Devix <noreply@devix.app>
FRONTEND_URL=http://localhost:3000

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW=1m

CORS_ORIGINS=http://localhost:3000,https://devix.app
